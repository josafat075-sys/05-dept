---
import type { CollectionEntry } from 'astro:content';
import { etiqueta, precio } from '../utils';

interface Props {
  prenda: CollectionEntry<'ropa'>;
}

const { prenda } = Astro.props;
const { nombre, precio: valor, categoria, imagen, galeria, color, agotado, destacado } = prenda.data;
const imagenTarjeta = imagen || galeria[0];
---

<a class="tarjeta" href={`/tienda/${prenda.id}`}>
  <div class="foto" style={`background:${color}`}>
    {imagenTarjeta ? <img src={imagenTarjeta} alt={nombre} loading="lazy" /> : <span>{nombre.charAt(0)}</span>}
    {agotado && <b class="sello agotado">Vendido</b>}
    {!agotado && destacado && <b class="sello">Favorito</b>}
  </div>
  <div class="info">
    <small class="mono">{etiqueta(categoria)}</small>
    <h3>{nombre}</h3>
    <p class="mono">{precio(valor)}</p>
  </div>
</a>

<style>
  .tarjeta {
    display: block; text-decoration: none; background: var(--papel);
    border: var(--borde); transition: transform 0.12s, box-shadow 0.12s;
  }
  .tarjeta:hover { transform: translate(-4px, -4px); box-shadow: var(--sombra); }

  .foto {
    position: relative; aspect-ratio: 4 / 5; overflow: hidden;
    display: grid; place-items: center; border-bottom: var(--borde);
  }
  .foto img { width: 100%; height: 100%; object-fit: cover; }
  .foto span { font: 900 6rem/1 var(--f-display); font-stretch: 125%; opacity: 0.18; }

  /* Sello tipo sticker */
  .sello {
    position: absolute; top: 10px; left: 10px; transform: rotate(-4deg);
    font: 700 0.7rem/1 var(--f-mono); text-transform: uppercase; letter-spacing: 0.08em;
    padding: 6px 10px; background: var(--mostaza); color: var(--tinta); border: var(--borde);
  }
  .sello.agotado { background: var(--acento); color: var(--papel); }

  .info { padding: 12px 14px 14px; }
  small { color: var(--suave); }
  h3 { margin: 4px 0 8px; font-size: 1.15rem; }
  p { margin: 0; font-weight: 700; }
</style>
