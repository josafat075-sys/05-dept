---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import CatalogoInteractivo from '../components/CatalogoInteractivo.astro';

const prendas = await getCollection('ropa');
---

<Base titulo="Tienda" descripcion="Toda la ropa de 05 DEPT. Filtra por categoría y encuentra tu pieza.">
  <div class="contenedor seccion">
    <div class="encabezado">
      <h1>Tienda</h1>
      <span class="mono">{prendas.length} piezas</span>
    </div>
    <CatalogoInteractivo tipo="ropa" prendas={prendas} />
  </div>
</Base>

<style>
  h1 { font-size: clamp(2.4rem, 8vw, 5rem); margin: 0; }
</style>
